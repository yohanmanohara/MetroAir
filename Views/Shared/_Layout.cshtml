<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UserRoles</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UserRoles.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm border-bottom">
    <div class="container">
        <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
            <i class="fas fa-plane-departure me-2"></i> MetroAir
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">


               
                @if (User.IsInRole("WebMaster"))
                {
                    <li class="nav-item">
                                <a class="nav-link text-dark fw-semibold" asp-controller="Home" asp-action="UserManagement">WebMaster</a>
                    </li>
                }
                @if (User.IsInRole("DataProvider"))
                {
                    <li class="nav-item">
                                <a class="nav-link text-dark fw-semibold" asp-controller="Home" asp-action="SystemLog">DataProvider</a>
                    </li>
                }
                @if (User.IsInRole("MonitoringAdmin"))
                   {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-semibold" asp-controller="Home" asp-action="MonitoringAdmin">MonitoringAdmin</a>
                            </li>
                    }
              
             
                <partial name="_LoginPartial" />
            </ul>
        </div>
    </div>
</nav>

    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

   @if (!ViewData["HideFooter"]?.Equals(true) ?? true)
{
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - MetroAir - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
