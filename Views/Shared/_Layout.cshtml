<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MetroAir</title>
    <script type="importmap"></script>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MetroAir.styles.css" asp-append-version="true" />

</head>
<body class="bg-gray-100 text-gray-800">
    <header>
        <nav class="bg-white shadow-sm mb-3">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center py-3">
                    <a class="text-xl font-semibold text-gray-900" href="@Url.Action("Index", "Home")">MetroAir</a>
                    
                    <button type="button" class="lg:hidden text-gray-600 hover:text-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" aria-controls="navbar" aria-expanded="false">
                        <span class="sr-only">Open main menu</span>
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>

                    <div class="hidden lg:flex space-x-4">
                        <a href="@Url.Action("Index", "Home")" class="text-gray-900 hover:text-gray-600">Home</a>
                        <a href="@Url.Action("Privacy", "Home")" class="text-gray-900 hover:text-gray-600">Privacy</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <main role="main" class="py-8">
            <h1 class="text-3xl font-bold underline text-indigo-600">
                Hello world!
            </h1>
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-t py-4">
        <div class="container mx-auto text-center text-gray-600">
            &copy; 2025 - MetroAir - <a href="@Url.Action("Privacy", "Home")" class="text-indigo-600 hover:text-indigo-800">Privacy</a>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
     @* <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script> *@
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
