<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/account.css" />
    <style>
        /* Custom CSS for black sidebar */
        #sidebar {
            background-color: #000; /* Black background */
            color: #fff; /* White text */
            min-height: 100vh; /* Full height */
        }

            #sidebar .nav-link {
                color: #fff; /* White text for links */
            }

                #sidebar .nav-link.active {
                    background-color: #333; /* Darker background for active link */
                }

                #sidebar .nav-link:hover {
                    background-color: #444; /* Slightly lighter background on hover */
                }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">


            <partial name="~/Views/Components/NavComponent.cshtml" />
            
            <nav id="sidebar" class="col-md-3 col-lg-2 d-md-block sidebar">
                <div class="position-sticky pt-3">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="UserManagement">
                                User Management
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="SystemConfiguration">System Configuration</a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Basicsecuritysetup">
                                Basic security setup
                            </a>
                        </li>
                        
                    </ul>
                </div>
            </nav>

            <!-- Main Content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>