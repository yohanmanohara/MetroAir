@{
    ViewBag.Title = "User Management";
    Layout = "~/Views/Shared/_MonitoringAdminLayout.cshtml";
}

<div class="container mt-4">
    <h2 class="mb-4 text-primary">User Management - Sensor Management</h2>

    <!-- Add Sensor Form -->
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Add New Sensor</h5>
        </div>
        <div class="card-body">
            <form method="post" action="@Url.Action("AddSensor", "Sensor")">
                <div class="row">
                    <div class="col-md-4">
                        <label class="form-label">Sensor Name</label>
                        <input type="text" name="sensorName" class="form-control" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Sensor Type</label>
                        <input type="text" name="sensorType" class="form-control" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Location</label>
                        <input type="text" name="location" class="form-control" required>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-4">
                        <label class="form-label">Status</label>
                        <select name="status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Created Date</label>
                        <input type="date" name="createdDate" class="form-control" required>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-success w-100">Add Sensor</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Display Sensors -->
    <h3 class="mb-3">Added Sensors</h3>
    <div class="row">
        @if (ViewBag.Sensors != null && ViewBag.Sensors.Count > 0)
        {
            @foreach (var sensor in ViewBag.Sensors)
            {
                <div class="col-md-4">
                    <div class="card mb-3">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">@sensor.Name</h5>
                        </div>
                        <div class="card-body">
                            <p><strong>Type:</strong> @sensor.Type</p>
                            <p><strong>Location:</strong> @sensor.Location</p>
                            <p><strong>Status:</strong> <span class="badge bg-@(sensor.Status == "Active" ? "success" : "danger")">@sensor.Status</span></p>
                            <p><strong>Created Date:</strong> @sensor.CreatedDate.ToShortDateString()</p>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted">No sensors added yet.</p>
        }
    </div>
</div>
    