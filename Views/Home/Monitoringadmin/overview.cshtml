@{
    ViewBag.Title = "View System Status";
    Layout = "~/Views/Shared/_MonitoringAdminLayout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">View System Status</h2>

    <div class="row">
        <!-- Simulation Status -->
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Simulation Status</h5>
                </div>
                <div class="card-body">
                    <p class="fw-bold">Current Status: <span class="badge bg-success">Running</span></p>
                    <button class="btn btn-warning btn-sm">Pause Simulation</button>
                    <button class="btn btn-danger btn-sm">Stop Simulation</button>
                </div>
            </div>
        </div>

        <!-- Number of Active Sensors -->
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Active Sensors</h5>
                </div>
                <div class="card-body">
                    <h3 class="fw-bold text-primary">15 Sensors Active</h3>
                    <button class="btn btn-outline-primary btn-sm">View Details</button>
                </div>
            </div>
        </div>
    </div>

    <!-- System Health Status -->
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">System Health Status</h5>
                </div>
                <div class="card-body">
                    <p class="fw-bold">Overall System Health: <span class="badge bg-info">Stable</span></p>
                    <p>Last Checked: <span class="text-muted">@DateTime.Now.ToString("MMMM dd, yyyy HH:mm")</span></p>
                    <button class="btn btn-outline-success btn-sm">Refresh Status</button>
                </div>
            </div>
        </div>
    </div>
</div>
