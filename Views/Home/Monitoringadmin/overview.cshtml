@{
    ViewBag.Title = "View System Status";
    Layout = "~/Views/Shared/_MonitoringAdminLayout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">View System Status</h2>

    <div class="row">
        <!-- Number of Active Sensors -->
        <div class="col-md-6 d-flex justify-content-center">
            <div class="card shadow-sm rounded-lg" style="max-width: 400px; width: 100%;">
                <div class="card-header bg-secondary text-white text-center">
                    <h5 class="mb-0">Active Sensors</h5>
                </div>
                <div class="card-body text-center">
                    <div id="loadingSpinner" class="spinner-border text-primary" role="status" style="display: none;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <h3 id="activeSensors" class="fw-bold text-primary" style="font-size: 2rem;">
                        Loading...
                    </h3>
                    <p id="additionalInfo" class="mt-3 text-muted" style="font-size: 1rem;"></p>
                </div>
                <div class="card-footer text-center bg-light">
                    <small class="text-muted">Last updated: <span id="lastUpdated">Just now</span></small>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const fetchActiveSensors = async () => {
            try {
                // Show the loading spinner
                document.getElementById("loadingSpinner").style.display = "block";

                const response = await fetch("/Home/overview", { method: "POST", headers: { "Content-Type": "application/json" } });
                if (!response.ok) {
                    throw new Error("Network response was not ok.");
                }
                const data = await response.json();

                // Hide the loading spinner once data is fetched
                document.getElementById("loadingSpinner").style.display = "none";

                // Update the content of the card
                document.getElementById("activeSensors").textContent = `${data.activeSensors} Sensors Active`;

                // Add additional information
                document.getElementById("additionalInfo").textContent = `Total Sensors: ${data.totalSensors}, Last Checked: ${new Date().toLocaleTimeString()}`;

                // Update last updated time
                document.getElementById("lastUpdated").textContent = new Date().toLocaleTimeString();
            } catch (error) {
                // Hide the loading spinner and show an error message
                document.getElementById("loadingSpinner").style.display = "none";
                document.getElementById("activeSensors").textContent = "Error loading data";
                console.error("Error fetching active sensors:", error);
            }
        };

        fetchActiveSensors();
    });
</script>
 