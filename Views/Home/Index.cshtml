            min-height: 60vh;
            display: flex;
            align-items: center;
            color: white;
            position: relative;
            width: 100vw;
            left: 50%;
            right: 50%;
            margin-left: -50vw;
            margin-right: -50vw;
        }

            .hero::after {
                content: '';
                position: absolute;
                bottom: -50px;
                left: 0;
                width: 100%;
                height: 100px;
                background: white;
                clip-path: polygon(0 70%, 100% 0, 100% 100%, 0% 100%);
            }

        .hero-content {
            z-index: 1;
        }
        .map {
            width: 100vw;
            position: relative;
            left: 50%;
            right: 50%;
            margin-left: -50vw;
            margin-right: -50vw;
        }
        /* Feature Cards */
        .feature-card {
            border: none;
            border-radius: 15px;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            height: 100%;
            background: white;
            position: relative;
        }

            .feature-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 15px 30px rgba(67, 97, 238, 0.2);
            }

            .feature-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 5px;
                background: linear-gradient(90deg, var(--primary), var(--accent));
                transition: all 0.3s ease;
            }

            .feature-card:hover::before {
                height: 10px;
            }

        .feature-icon {
            width: 80px;
            height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            margin: 0 auto 20px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: white;
            font-size: 2rem;
            box-shadow: 0 5px 15px rgba(67, 97, 238, 0.3);
            transition: all 0.3s ease;
        }

        .feature-card:hover .feature-icon {
            transform: rotate(15deg) scale(1.1);
        }

        /* About Section */
        .about-section {
            position: relative;
            overflow: hidden;
        }

            .about-section::before {
                content: '';
                position: absolute;
                top: -100px;
                left: 0;
                width: 100%;
                height: 100px;
                background: white;
                clip-path: polygon(0 0, 100% 30%, 100% 100%, 0% 100%);
            }

        /* Testimonial Cards */
        .testimonial-card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

            .testimonial-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 35px rgba(67, 97, 238, 0.15);
            }

            .testimonial-card::after {
                content: '"';
                position: absolute;
                top: 20px;
                right: 30px;
                font-size: 5rem;
                color: rgba(67, 97, 238, 0.05);
                font-family: serif;
                line-height: 1;
            }

        .user-avatar {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid white;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        /* CTA Section */
        .cta-section {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            position: relative;
            overflow: hidden;
            width: 100vw;
            left: 50%;
            right: 50%;
            margin-left: -50vw;
            margin-right: -50vw;
        }

            .cta-section::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100px;
                background: white;
                clip-path: polygon(0 0, 100% 0, 100% 30%, 0 100%);
            }

            .cta-section::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                width: 100%;
                height: 100px;
                background: white;
                clip-path: polygon(0 70%, 100% 100%, 100% 100%, 0% 100%);
            }

        /* Footer */
        footer {
            background: var(--dark);
            color: white;
            padding: 0;
            width: 100vw;
            position: relative;
            left: 50%;
            right: 50%;
            margin-left: -50vw;
            margin-right: -50vw;
        }

