@{
    ViewData["Title"] = "Air Quality Monitoring";
}

<div class="container-fluid p-0">
    <!-- Hero Section -->
    <header class="bg-primary text-white text-center py-5">
        <div class="container">
            <h1 class="display-3 fw-bold">Check Your Air Quality</h1>
            <p class="lead">Real-time air pollution levels in your city.</p>
            <a href="#air-quality" class="btn btn-light btn-lg">View Air Quality</a>
        </div>
    </header>

    <!-- Air Quality Information -->
    <section id="air-quality" class="py-5">
        <div class="container text-center">
            <h2 class="fw-bold">Current Air Quality Index</h2>
            <p class="text-muted">Live updates on air pollution levels in major cities.</p>

            <div class="row mt-4">
                <div class="col-md-4">
                    <div class="card border-success">
                        <div class="card-body">
                            <h5 class="card-title text-success">New York</h5>
                            <p class="card-text">AQI: 42 (Good)</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-warning">
                        <div class="card-body">
                            <h5 class="card-title text-warning">Los Angeles</h5>
                            <p class="card-text">AQI: 120 (Moderate)</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-danger">
                        <div class="card-body">
                            <h5 class="card-title text-danger">Delhi</h5>
                            <p class="card-text">AQI: 250 (Unhealthy)</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="bg-light py-5">
        <div class="container text-center">
            <h2 class="fw-bold">Why Choose Us?</h2>
            <div class="row mt-4">
                <div class="col-md-4">
                    <i class="fas fa-cloud-sun fa-3x text-primary"></i>
                    <h5 class="mt-3">Real-Time Data</h5>
                    <p>Instant updates on air pollution levels.</p>
                </div>
                <div class="col-md-4">
                    <i class="fas fa-mobile-alt fa-3x text-primary"></i>
                    <h5 class="mt-3">Mobile Friendly</h5>
                    <p>Access air quality data from any device.</p>
                </div>
                <div class="col-md-4">
                    <i class="fas fa-shield-alt fa-3x text-primary"></i>
                    <h5 class="mt-3">Health Recommendations</h5>
                    <p>Get safety tips based on AQI levels.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-4">
        <p class="mb-0">© 2025 Air Quality Monitor | All Rights Reserved.</p>
    </footer>
</div>

