@model MetroAir.Models.User

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - MetroAir</title>
    <link rel="stylesheet" href="~/css/authform.css" asp-append-version="true" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/jquery.validation/1.19.3/jquery.validate.min.js"></script>
</head>

<body>
    <div class="login-container">
        <h2>Sign Up</h2>

        
        @if (TempData["Success"] != null)
        {
            <script>
                Swal.fire({
                    title: 'Success!',
                    text: '@TempData["Success"]',
                    icon: 'success',
                    confirmButtonText: 'OK'
                }).then(function() {
                    // Redirect to the Login page after the alert is closed
                    window.location.href = '@Url.Action("Login", "Account")';
                });
            </script>
        }
        
        @if (TempData["Error"] != null)
        {
            <script>
                Swal.fire({
                    title: 'Error',
                    text: '@TempData["Error"]',
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
            </script>
        }

        <form asp-action="Signup" method="post" id="signupForm">
            <div class="input-group">
                <label for="email">Email</label>
                <input id="email" name="Email" type="email" class="input-field" placeholder="Enter your email" required />
            </div>

            <div class="input-group">
                <label for="username">Username</label>
                <input id="username" name="Username" type="text" class="input-field" placeholder="Choose a username" required />
            </div>

            <div class="input-group">
                <label for="password">Password</label>
                <input id="password" name="Password" type="password" class="input-field" placeholder="Create a password" required />
            </div>

            <button type="submit" class="btn-login">Sign Up</button>

            <p>Already have an account? <a href="@Url.Action("Login", "Account")">Log in</a></p>
        </form>
    </div>
</body>

</html>
